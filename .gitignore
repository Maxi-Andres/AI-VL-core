# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Benchmark results (regenerated; only the folder is versioned)
results/*.json
# llama-server logs written by src/vlm_server_benchmark.py
results/*.log

# Annotated (boxed) images saved by the YOLO scan
results/annotated/

# YOLO weights (auto-downloaded by ultralytics on first use)
*.pt

# Piper TTS voice models (downloaded by the installer)
piper_voices/

# Kokoro TTS model files (downloaded by the installer; ~340 MB)
kokoro_models/

# Supertonic 3 TTS model files (downloaded by the installer; ~380 MB)
supertonic_models/

# VLM weights for llama-server (GGUF model + vision projector; downloaded by the installer,
# several GB each)
vlm_models/

# Speech test clips downloaded by src/asr_benchmark.py --fetch (OpenSLR 61)
asr_data/

# Voice samples written by src/tts_benchmark.py (listen, do not commit)
results/tts_samples/
